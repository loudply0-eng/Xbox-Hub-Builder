[Unit]
Description=Publish verified Xbox Hub stable releases from OCI Vault
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
User=xboxhub-release
Group=xboxhub-updates
SupplementaryGroups=xboxhub-updates
WorkingDirectory=/opt/xboxhub-release-agent
EnvironmentFile=/etc/xboxhub-release-agent.env
ExecStart=/opt/xboxhub-release-agent/venv/bin/python /opt/xboxhub-release-agent/xboxhub_release_agent.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/www/xbox-hub-updates/stable /var/lib/xboxhub-release-agent

[Install]
WantedBy=multi-user.target
