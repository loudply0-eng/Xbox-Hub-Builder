# Fill each placeholder with the values from your OCI Vault and Compute instance.
# This file contains identifiers and endpoints only; it must never contain a PEM or passphrase.
XBOXHUB_KMS_CRYPTO_ENDPOINT=https://REPLACE_WITH_VAULT_CRYPTO_ENDPOINT
XBOXHUB_PACKAGE_KEY_OCID=REPLACE_WITH_PACKAGE_DECRYPTION_KEY_OCID
XBOXHUB_PACKAGE_KEY_VERSION_OCID=REPLACE_WITH_PACKAGE_DECRYPTION_KEY_VERSION_OCID
XBOXHUB_SIGNING_KEY_OCID=REPLACE_WITH_RELEASE_SIGNING_KEY_OCID
XBOXHUB_SIGNING_KEY_VERSION_OCID=REPLACE_WITH_RELEASE_SIGNING_KEY_VERSION_OCID
XBOXHUB_STABLE_DIR=/var/www/xbox-hub-updates/stable
XBOXHUB_STATE_FILE=/var/lib/xboxhub-release-agent/state.json
